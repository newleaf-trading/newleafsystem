# ============================================================================
# NewLeaf video pipeline — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================================

# --- BytePlus ModelArk (Seedance cinematic generation) ------------------------
# Bearer token for the Ark v3 API. Keys are usually prefixed "ark-".
BYTEPLUS_API_KEY=
# Model id used for DRAFT quality (fast / lite). Suffixes rotate — verify in the
# ModelArk model-list console for your region.
BYTEPLUS_MODEL_FAST=seedance-1-0-lite-t2v-250428
# Model id used for FINAL quality (pro).
BYTEPLUS_MODEL_PRO=seedance-1-0-pro-250528

# --- Kling (realistic-face fallback) -----------------------------------------
# OPTIONAL. If unset, scenes routed to kling fail cleanly with instructions.
KLING_API_KEY=

# --- Voiceover TTS -----------------------------------------------------------
# Which engine produces the spoken voiceover: elevenlabs | openai | heygen.
# NOTE: HeyGen standalone TTS (/v3/voices/speech, "Starfish") is gated on some
# accounts — if your voices error with "STARFISH is not supported", use
# elevenlabs or openai here. HeyGen is still used for avatar lip-sync.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# REQUIRED (no default). Must be a voice usable on your plan AND matched to your
# avatar (gender/tone) — a silent default is how the avatar/voice mismatch bug
# happened. Free-tier premade examples: Sarah EXAVITQu4vr4xnSDxMaL (warm F),
# Matilda XrExE9yKIg1WjnnlVkGX (F), George JBFqnCBsd6RMkjVDRZzb (M).
ELEVENLABS_VOICE_ID=
# --- or OpenAI TTS ---
OPENAI_API_KEY=
OPENAI_TTS_VOICE=onyx

# --- HeyGen (avatar / presenter scenes; also TTS if TTS_PROVIDER=heygen) ------
HEYGEN_API_KEY=
# Avatar id for presenter scenes (from HeyGen avatar library).
HEYGEN_AVATAR_ID=
# Voice id used only when TTS_PROVIDER=heygen.
HEYGEN_VOICE_ID=

# --- Cloudflare R2 (publish target, S3-compatible) ---------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# OPTIONAL public base URL for the bucket (custom domain or r2.dev). If set,
# publish.js uses it to build the public URL; otherwise it records the R2 key.
R2_PUBLIC_BASE_URL=

# --- Social distribution (publish step) --------------------------------------
# All social publishing is DRY-RUN unless SOCIAL_PUBLISH=1. Even then, Instagram
# only CREATES a container (a human releases it) unless the manifest sets
# distribution.instagram.publish=true. See docs/YOUTUBE-INSTAGRAM-PIPELINE.md §7.
SOCIAL_PUBLISH=

# YouTube Data API v3 (OAuth2 refresh-token flow). Live upload also needs
# `npm i googleapis`. NOTE: unaudited API projects force uploads to private (§7.1).
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Instagram Graph API. Requires an IG Business/Creator account linked to a
# Facebook Page + a long-lived token. The API fetches the video from the public
# R2 URL, so the bucket (or a ≥1h presign) must be publicly reachable.
IG_USER_ID=
IG_ACCESS_TOKEN=

# Loudness target for the assemble step (default -16). Social masters use -14.
LOUDNESS_LUFS=
