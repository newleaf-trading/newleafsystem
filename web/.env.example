# Copy to .env (gitignored) and fill in. Vite inlines VITE_* into the bundle;
# scripts/inject-env.js substitutes VITE_NL_API_KEY into the static HTML pages.

# API gateway base URL for the workbench
VITE_API_BASE_URL=

# Scheduler API endpoint
VITE_SCHEDULER_API=

# Admin email whitelist (comma-separated)
VITE_ADMIN_EMAILS=

# NewLeaf API key sent as the x-api-key header by client features and the
# static workbench pages. Required for the build (inject-env.js fails without
# it). Note: this value ships in the public client bundle, so it must be a
# LEAST-PRIVILEGE key — never an admin key — and should be rotatable in Firestore.
VITE_NL_API_KEY=
