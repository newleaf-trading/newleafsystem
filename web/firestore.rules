rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Operator/admin allowlist (mirrors web/src/shared/lib/admins.js) ───
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['manish28june@gmail.com', 'manishsaraan@gmail.com'];
    }

    // ─── Plan templates — operator-owned, versioned. Authed read; admin write only ───
    match /planTemplates/{templateId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // ─── Weekly qualified setups — scanner quality-bar counts. Authed read; ───
    // ─── written only by the server-side pipeline (admin). ───
    match /weeklyQualifiedSetups/{weekId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // ─── Strategies (tiles) — scanner output, public read ───
    match /tiles/{tileId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    // ─── Analyses — paired to tiles, public read ───
    match /analyses/{tileId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    // ─── Weekly Picks — public read ───
    match /weeklyPicks/{weekId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    // ─── Recommendations — authenticated read/write ───
    match /recommendations/{recId} {
      allow read, create, update: if request.auth != null;
    }

    // ─── Pick outcomes + market state — public read ───
    match /pick_outcomes/{docId} {
      allow read: if true;
    }

    // ─── Recommendation log — engine decision snapshots for outcome tracking ───
    match /recommendation_log/{docId} {
      allow read: if true;
    }
    match /marketState/{docId} {
      allow read: if true;
    }

    // ─── User data — owner only ───
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Positions (self-contained, replaces portfolio)
      match /positions/{posId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Verdict history + adjustments
        match /{sub}/{docId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Legacy portfolio (keep for migration, remove later)
      match /portfolio/{posId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        match /{sub}/{docId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Plan of Record — frozen plan snapshots, owner-only (explicit for clarity)
      match /planOfRecord/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Shortlist, settings, snapshots, orders, alerts
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── Discover usage ───
    match /discover_usage/{userId} {
      allow read, create, update: if request.auth != null;
      match /{sub}/{docId} {
        allow read, create, update: if request.auth != null;
      }
    }

    // ─── Publications ───
    match /publications/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
    }

    // ─── TIQ assessment — server-authoritative (docs/tiq/TIQ-BUILD.md) ───
    // The route layer's append-only and server-side-scoring guarantees are only
    // real if a client cannot write or read these collections directly.

    // Sittings: a client may read ONLY its own document, and never write. Every
    // write goes through the server (the Admin SDK bypasses rules).
    match /tiqSittings/{sittingId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // Items carry the answer key, scoring blocks and explanations — server only.
    // Clients read the stripped projection in tiqItemsPublic instead.
    match /tiqItems/{itemId} {
      allow read, write: if false;
    }
    match /tiqItemsPublic/{itemId} {
      allow read: if true;   // stripped: no choice_points, no correct answer, no explanation
      allow write: if false;
    }

    // Bank metadata (trait vocabulary, category weights) — no answers, no secrets.
    match /tiqBanks/{version} {
      allow read: if true;
      allow write: if false;
    }

    // Frozen norms and item stats — read-only to clients, server write only.
    match /tiqNorms/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /tiqItemStats/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    // Scenarios carry the per-option decision points (the simulator's answer key),
    // so — like tiqItems — they are SERVER-ONLY. Clients get a points-stripped
    // scenario from POST /api/tiq/sim/:scenarioId/sessions, never a direct read.
    // DO NOT relax to client-read: these are NOT reference data — the scoring key
    // lives inside the scenario document, so a client read would leak it.
    match /tiqScenarios/{scenarioId} {
      allow read, write: if false;
    }

    // Simulator sessions: repeatable, one per attempt, server-write only. A client
    // may read only its own session (which carries its own decision points).
    match /tiqSimSessions/{sessionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // ─── Public-read safety net for any other collection. The top-level
    // collection name is bound so the sensitive TIQ collections above can be
    // carved out — a bare `match /{document=**} { allow read: if true }` would
    // OR-override their restrictions and silently make sittings and keyed items
    // world-readable. Non-tiq collections keep their previous public-read. ───
    match /{col}/{docId} {
      allow read: if !(col in ['tiqSittings', 'tiqItems', 'tiqScenarios', 'tiqSimSessions']);
    }
    match /{col}/{docId}/{document=**} {
      allow read: if !(col in ['tiqSittings', 'tiqItems', 'tiqScenarios', 'tiqSimSessions']);
    }
  }
}
